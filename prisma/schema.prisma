generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reply {
  id          String   @id @default(cuid())
  messageId   String
  threadId    String
  replyText   String
  confidence  Float
  snippetIds  String[]
  outcome     String?
  sentAt      DateTime @default(now())

  @@index([messageId, threadId])
}

model QaSnapshot {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  total      Int
  escalated  Int
  duplicates Int
  p50Len     Int
}
