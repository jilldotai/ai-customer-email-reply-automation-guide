{
  "name": "ai-customer-email-reply-automation-guide",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Production-ready AI customer service automation with cost controls and hallucination prevention",
  "scripts": {
    "dev": "tsx src/server.enhanced.ts",
    "build": "tsc -p .",
    "start": "node dist/server.enhanced.js",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "lint": "eslint .",
    "test": "tsx --test ./tests/**/*.test.ts",
    "itest": "node ./tests/reply.integration.ts",
    "troubleshoot": "npx tsx scripts/troubleshoot.ts",
    "mint:gmail": "tsx scripts/oauth-mint-refresh-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@prisma/client": "^6.18.0",
    "fastify": "^4.28.1",
    "googleapis": "^140.0.0",
    "redis": "^4.6.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^9.13.0",
    "prisma": "^6.18.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
