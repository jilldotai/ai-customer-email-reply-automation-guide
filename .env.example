# KEEP THIS FILE SECRET - it contains API keys and sensitive configuration
# Change file name to .env before running the automation in production and fill in the values before running the application
# Add your own values where indicated
# Comment out optional settings you do not wish to use

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Redis (required for idempotency)
REDIS_URL=redis://localhost:6379

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Gmail OAuth2 (required for sending emails)
# Follow setup guide: https://developers.google.com/gmail/api/quickstart
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=support@yourcompany.com

# Department Email Routing (required)
# These receive escalated cases by category 
# Adjust as needed and ensureto adjust the path according 
# Change accordingly in the application code if you modify these
BILLING_EMAIL=billing@yourcompany.com
LOGISTICS_EMAIL=logistics@yourcompany.com
ADMIN_EMAIL=admin@yourcompany.com
COMPLAINTS_EMAIL=complaints@yourcompany.com

# Optional: Cost Alerts
# Adjust as needed
DAILY_COST_LIMIT_USD=10.00
ALERT_EMAIL=alerts@yourcompany.com

# Optional: Feature Flags
ENABLE_PROMPT_CACHING=true
ENABLE_TEMPLATE_ROUTING=true
MIN_CONFIDENCE_THRESHOLD=0.8
MAX_TOKENS_PER_RESPONSE=500

# Optional: Rate Limiting
RATE_LIMIT_PER_THREAD=10
RATE_LIMIT_WINDOW_HOURS=1

# Optional: Monitoring
SENTRY_DSN=
DATADOG_API_KEY=